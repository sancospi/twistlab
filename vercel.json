{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/((?!_vercel/|assets/|api/).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/assets/((?!search-worker-entry\\.js).*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }]
}
