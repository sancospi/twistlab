{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/((?!_vercel/|assets/|api/).*)", "destination": "/app.html" }],
  "headers": [{ "source": "/hoy", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }, { "source": "/:lang(en|pt)/hoy", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }, { "source": "/assets/((?!search-worker-entry\\.js).*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }],
  "crons": [{ "path": "/api/cron/reminders", "schedule": "0 * * * *" }]
}
