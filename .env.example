# Copy to .env.local (never committed) and fill in. On Vercel, set the same names in the project's Environment Variables.

# Postgres (Neon or any Postgres the @neondatabase/serverless driver reaches). Without it the app still works: no
# account, sync, challenges nor reminders. `npm run db:migrate` creates the tables and the challenges' scrambles.
DATABASE_URL=

# Signs the account's sessions and login codes: a long random string, e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# The login codes' email (Resend). Without the key, the local dev server prints the code in its console instead.
RESEND_API_KEY=
MAIL_FROM="TwistLab <login@example.com>"

# The daily practice reminder (Web Push): a VAPID key pair in base64url, e.g. `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vercel Cron sends it as a Bearer token to /api/cron/reminders: any long random string.
CRON_SECRET=
